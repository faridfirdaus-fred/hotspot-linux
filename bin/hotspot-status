#!/usr/bin/env bash
# hotspot-linux managed
set -euo pipefail
self=$(readlink -f -- "$0")
repo=$(dirname -- "$(dirname -- "$self")")
ctl=$repo/lib/lar-control.sh
if [[ ! -x $ctl ]]; then
    ctl=${HOTSPOT_LINUX_REPO:-@REPO@}/lib/lar-control.sh
fi
if [[ -x $ctl ]]; then
    exec "$ctl" status "$@"
fi
printf 'ERROR: lar-control.sh not found (set HOTSPOT_LINUX_REPO=/path/to/repo)\n' >&2
exit 1
