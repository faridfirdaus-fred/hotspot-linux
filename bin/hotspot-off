#!/usr/bin/env bash
# hotspot-linux managed
set -euo pipefail
verb=stop
SVC=create_ap.service
self=$(readlink -f -- "$0")
repo=$(dirname -- "$(dirname -- "$self")")
ctl=$repo/lib/lar-control.sh
if [[ ! -x $ctl ]]; then
    ctl=${HOTSPOT_LINUX_REPO:-@REPO@}/lib/lar-control.sh
fi
is_on()  { [[ $(systemctl show "$SVC" -p ActiveState --value 2>/dev/null) == active ]]; }
is_off() { local s; s=$(systemctl show "$SVC" -p ActiveState --value 2>/dev/null); [[ $s == inactive || $s == failed ]]; }

if [[ -x $ctl ]]; then
    # passwordless fast paths (read-only checks, no root needed).
    # Only exact states qualify: starting/crashed units still need root
    # so the control script can stop/reset/align them.
    if [[ $verb == start ]] && is_on; then
        exec "$ctl" start          # prints summary without root
    fi
    if [[ $verb == stop ]] && is_off; then
        exec "$ctl" stop           # 'already OFF' without root
    fi
    exec sudo "$ctl" "$verb"
fi
# repo moved or removed — plain service control fallback
if [[ $verb == start ]] && is_on; then
    printf 'hotspot is ON (%s active).\n' "$SVC"
    exit 0
fi
if [[ $verb == stop ]] && is_off; then
    printf 'hotspot is already OFF.\n'
    exit 0
fi
exec sudo systemctl "$verb" "$SVC"
