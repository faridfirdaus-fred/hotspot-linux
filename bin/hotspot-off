#!/usr/bin/env bash
# hotspot-linux managed
set -euo pipefail
verb=stop
SVC=create_ap.service
self=$(readlink -f -- "$0")
repo=$(dirname -- "$(dirname -- "$self")")
ctl=$repo/lib/lar-control.sh
if [[ ! -x $ctl ]]; then
    ctl=${HOTSPOT_LINUX_REPO:-@REPO@}/lib/lar-control.sh
fi
is_active() { systemctl is-active --quiet "$SVC" 2>/dev/null; }

if [[ -x $ctl ]]; then
    # passwordless fast paths (read-only checks, no root needed)
    if [[ $verb == start ]] && is_active; then
        exec "$ctl" start          # prints summary without root
    fi
    if [[ $verb == stop ]] && ! is_active; then
        exec "$ctl" stop           # prints 'already OFF' without root
    fi
    exec sudo "$ctl" "$verb"
fi
# repo moved or removed — plain service control fallback
if [[ $verb == start ]] && is_active; then
    printf 'hotspot is ON (%s active).\n' "$SVC"
    exit 0
fi
if [[ $verb == stop ]] && ! is_active; then
    printf 'hotspot is already OFF.\n'
    exit 0
fi
exec sudo systemctl "$verb" "$SVC"
